{
  "name": "marscompress",
  "version": "2.0.0",
  "description": "Open, query-aware context compression for chatbots and LLM applications.",
  "license": "MIT",
  "private": false,
  "homepage": "https://marscompress-open.cify6gaming.chatgpt.site",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GCGittiwilo/marscompress.git"
  },
  "bugs": {
    "url": "https://github.com/GCGittiwilo/marscompress/issues"
  },
  "keywords": [
    "llm",
    "chatbot",
    "context-compression",
    "rag",
    "prompt-optimization",
    "token-reduction",
    "ai"
  ],
  "sideEffects": false,
  "main": "./lib/compress.js",
  "types": "./lib/compress.d.ts",
  "files": [
    "lib",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./lib/compress.d.ts",
      "import": "./lib/compress.js"
    }
  },
  "bin": {
    "marscompress": "./bin/marscompress.mjs"
  },
  "overrides": {
    "postcss": "8.5.24",
    "sharp": "0.35.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "benchmark": "node scripts/benchmark.mjs",
    "benchmark:scale": "node scripts/scale-benchmark.mjs",
    "benchmark:pareto": "node scripts/pareto.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "next": "^16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@cloudflare/vite-plugin": "1.54.8",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "10.10.0",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vinext": "0.2.1",
    "vite": "8.3.0",
    "wrangler": "4.131.1"
  },
  "type": "module"
}
